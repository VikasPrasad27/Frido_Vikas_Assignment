# ReturnDesk Environment Variables

# PostgreSQL Database Connection String
# Works with local PostgreSQL, Docker, Neon, Supabase, Render, etc.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/returndesk?schema=public"

# Application Port (optional, default 3000)
PORT=3000

# Node Environment
NODE_ENV="development"
